{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/backend/Dockerfile",
    "watchPatterns": ["apps/backend/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node dist/worker.js",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 600
  }
}

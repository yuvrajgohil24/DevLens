# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://devlens:devlens@localhost:5432/devlens

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Backend ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── GitHub (Phase 2 — for real deploy triggers) ───────────
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your-github-username

# ── Pipeline Webhook ──────────────────────────────────────
# Shared secret used to verify the HMAC signature (X-DevLens-Signature-256) on
# POST /api/webhooks/pipeline. Set the same value as the DEVLENS_WEBHOOK_SECRET
# GitHub Actions secret. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
# Local development only: accept unsigned webhooks when WEBHOOK_SECRET is empty.
# Without this, unsigned webhooks are rejected.
ALLOW_UNSIGNED_WEBHOOKS=false

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ── Auth (Phase 3 — Clerk) ────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Use the in-app sign-in/sign-up pages (so the "Continue as Guest" button shows)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Access Control ────────────────────────────────────────
# Every signed-in user can read. Write actions (resolve, deploy, git) need the
# admin role: list Clerk user ids here, or set publicMetadata {"role":"admin"}
# on the user in the Clerk dashboard.
ADMIN_USER_IDS=
# Sign-up is invite-only by default. Also set Clerk → Restricted sign-up mode.
NEXT_PUBLIC_ALLOW_SIGN_UP=false
# Server-side git fetch/pull/push from the DevFlow page. Local development ONLY.
LOCAL_GIT_ACTIONS=false

# ── Public Demo / Guest Mode ──────────────────────────────
# The "Continue as Guest" button signs in via a backend-minted Clerk sign-in
# token (ticket) — no password is shipped to the browser, and it bypasses MFA.
# See SETUP_DEMO.md.
#
# DEMO_USER_ID: Clerk user id (user_xxx) of the read-only demo account. Used by
# the BACKEND to mint the sign-in token AND to block that user's write requests.
# Requires CLERK_SECRET_KEY (above) to be set on the backend.
DEMO_USER_ID=
# Email of the demo user — frontend only, used to show the "Demo mode" banner.
NEXT_PUBLIC_DEMO_EMAIL=demo@devlens.app

# ── Slack Alerts  ─────────────────────────────────────
SLACK_WEBHOOK_URL=your-slack-webhook-url

# ── Scan Worker ───────────────────────────────────────────
# false = API process doesn't run scans; run `npm run start:worker` separately
RUN_SCAN_WORKER=true
SCAN_CONCURRENCY=2
SCANNER_TIMEOUT_MS=600000
# Only for a Redis provider with a self-signed TLS cert (rediss://)
REDIS_TLS_INSECURE=false

# ── Logging ───────────────────────────────────────────────
# trace | debug | info | warn | error | silent. JSON logs in production, pretty-printed locally.
LOG_LEVEL=info

# ── Rate Limiting ─────────────────────────────────────────
# Reverse proxies in front of the API (Railway: 1). Default: 1 in production, 0 otherwise.
TRUST_PROXY=
# Per-IP limits (defaults shown)
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_WEBHOOK_PER_MIN=60
RATE_LIMIT_DEMO_PER_15MIN=10

# ── Local Development ─────────────────────────────────────
# Path where all your local git repositories are stored
LOCAL_WORKSPACE_DIR=C:\projects

# Optional: Path to specific scanner binaries if not in system PATH
TRIVY_BIN=
TRUFFLEHOG_BIN=
# Skip secret scanning of git history up to (and including) this commit SHA, e.g.
# old commits with known, already-rotated test secrets. Later commits are still
# scanned; repos that don't contain the commit get a full-history scan.
TRUFFLEHOG_SINCE_COMMIT=
# Fall back to labelled sample data when a scanner is unavailable.
# Default: on in development, off when NODE_ENV=production (scan fails instead).
MOCK_SCANNERS=
SNYK_TOKEN=your_snyk_api_token_here
